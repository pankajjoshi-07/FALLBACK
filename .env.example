# ==============================================================================
# Arcane Codex — Life RPG: Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your actual values.
# NEVER commit your real .env file to version control.

# PostgreSQL Connection String
# For local development (e.g. Docker or local PostgreSQL daemon):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arcanecodex?schema=public"
# For Neon / Supabase cloud deployment:
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection URL (optional, for migrations with connection poolers like Neon or Supabase)
# DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret key used for signing session tokens and cryptographic cookies (min 32 characters)
AUTH_SECRET="super-secret-cryptographic-signing-key-change-in-production-min-32-chars"

# Node Environment
NODE_ENV="development"
